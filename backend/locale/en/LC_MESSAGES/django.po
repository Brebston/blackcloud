#: apps/storage/views.py:634
msgid "Посилання недійсне або прострочене."
msgstr "Link is invalid or has expired."

#: apps/storage/views.py:56
#: apps/storage/views.py:61
msgid "Чанк завеликий."
msgstr "Chunk is too large."

#: apps/storage/views.py:576
msgid "Хтось підбирає пароль до вашого посилання"
msgstr "Someone is trying to guess your link's password"

#: apps/storage/views.py:577
#, python-format
msgid "Посилання на «%(name)s» тимчасово заблоковано на годину. Можливо, варто його відкликати."
msgstr "The link to “%(name)s” has been blocked for an hour. You may want to revoke it."

#: apps/storage/views.py:582
msgid "Підбір пароля публічного посилання"
msgstr "Public link password guessing"

#: apps/storage/views.py:583
#, python-format
msgid "Власник: %(username)s"
msgstr "Owner: %(username)s"

#: apps/storage/views.py:618
msgid "Забагато невдалих спроб. Спробуйте через годину."
msgstr "Too many failed attempts. Try again in an hour."

#: apps/storage/views.py:631
msgid "Посилання для завантаження прострочене. Оновіть сторінку."
msgstr "Download link has expired. Refresh the page."

#: apps/storage/views.py:640
msgid "Ліміт завантажень вичерпано."
msgstr "Download limit reached."

#: apps/storage/views_admin.py:110
msgid "Файл з карантину видалено"
msgstr "Quarantined file deleted"

#: apps/storage/views_admin.py:111
#, python-format
msgid "Адміністратор остаточно видалив «%(name)s»."
msgstr "An administrator permanently deleted “%(name)s”."

#: apps/storage/views_admin.py:145
msgid "Антивірус вимкнено в конфігурації."
msgstr "Antivirus is disabled in the configuration."

#: apps/storage/views_admin.py:35
msgid "Файл не знайдено в карантині."
msgstr "File not found in quarantine."

#: apps/storage/views_admin.py:45
msgid "Файли адміністраторів може видаляти лише суперкористувач."
msgstr "Only a superuser can delete administrators' files."

#: apps/storage/views_admin.py:85
msgid "Антивірус вимкнено в конфігурації — повторна перевірка неможлива."
msgstr "Antivirus is disabled in the configuration, so rescanning isn't possible."

#: apps/storage/views_office.py:34
msgid "Онлайн-редактор вимкнено."
msgstr "The online editor is disabled."

#: apps/storage/views_office.py:46
msgid "Цей формат не відкривається в редакторі."
msgstr "This format can't be opened in the editor."

#: apps/storage/views_office.py:48
msgid "Файл ще перевіряється антивірусом або заблокований."
msgstr "File is still being scanned by antivirus or is blocked."
