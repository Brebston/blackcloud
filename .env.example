# ─── Загальне ────────────────────────────────────────────────
# Домен веб-інтерфейсу (має вказувати A/AAAA-записом на сервер)
DOMAIN=cloud.example.com
ACME_EMAIL=admin@example.com
# Для локальної розробки: DOMAIN=localhost, TLS_RESOLVER= (порожньо), SNI_STRICT=false
TLS_RESOLVER=letsencrypt
SNI_STRICT=true

# Секретний префікс адмінки Django (змініть на випадковий)
ADMIN_URL_PREFIX=bc-admin

# DEBUG дозволено лише з DOMAIN=localhost (інакше backend не стартує)
DJANGO_DEBUG=false
TIME_ZONE=Europe/Kyiv
LANGUAGE_CODE=uk

# ─── Користувачі та квоти ───────────────────────────────────
# Відкрита реєстрація (false = лише за запрошеннями від адміністратора)
REGISTRATION_OPEN=false
# Квота за замовчуванням для нового користувача, ГБ
DEFAULT_QUOTA_GB=10
# Максимальний розмір одного файлу, ГБ
MAX_FILE_SIZE_GB=10
# Адміністратори зобов'язані мати 2FA
REQUIRE_2FA_FOR_STAFF=true

# ─── Файли ──────────────────────────────────────────────────
S3_BUCKET=blackcloud-files
# Що робити з файлами, які ClamAV не може перевірити (завеликі): block | allow
UNSCANNED_POLICY=block

# ─── Пошта ──────────────────────────────────────────────────
# Поштовий домен (MX-запис має вказувати на MAIL_HOSTNAME)
MAIL_DOMAIN=example.com
MAIL_HOSTNAME=mail.example.com
# Автоматично створювати скриньку username@MAIL_DOMAIN для нових користувачів
MAIL_AUTO_CREATE=true
MAIL_DEFAULT_QUOTA_MB=2048

# ─── Піддомени (окремі origin для ізоляції) ──────────────────
# Редактор документів і перегляд файлів у браузері працюють на окремих піддоменах.
# Обидва мають вказувати DNS-записом на сервер (як і DOMAIN). За замовчуванням:
# OFFICE_HOST=office.<DOMAIN>
# USERCONTENT_HOST=usercontent.<DOMAIN>

# ─── Онлайн-редактор документів (ONLYOFFICE) ───
# Значення додає scripts/init-secrets.sh (make secrets)
# OFFICE_ENABLED=true
# COMPOSE_PROFILES=office
# OFFICE_JWT_SECRET=

# ─── Закріплені образи (make pin записує сюди digest) ───────
# PYTHON_IMAGE= NODE_IMAGE= NGINX_IMAGE= DEBIAN_IMAGE=
# TRAEFIK_IMAGE= POSTGRES_IMAGE= REDIS_IMAGE= OFFICE_IMAGE=

# ─── Пошта: антиспам і сертифікат ───────────────────────────
# Безкоштовний ключ Spamhaus DQS (spamhaus.com → Data Query Service → Free).
# Потрібен, бо Spamhaus не відповідає на запити через публічні/провайдерські DNS.
SPAMHAUS_DQS_KEY=
# Сертифікат Let's Encrypt для MAIL_HOSTNAME через Traefik: додайте mailcert у COMPOSE_PROFILES,
# напр. COMPOSE_PROFILES=office,mailcert
