# ─── Загальне ─────────────────────────────────────────────────
# Домен веб-інтерфейсу (має вказувати A/AAAA-записом на сервер)
DOMAIN=cloud.example.com
ACME_EMAIL=admin@example.com
# Для локальної розробки: DOMAIN=localhost, TLS_RESOLVER= (порожньо), SNI_STRICT=false
TLS_RESOLVER=letsencrypt
SNI_STRICT=true

# Секретний префікс адмінки Django (змініть на випадковий)
ADMIN_URL_PREFIX=bc-admin

DJANGO_DEBUG=false
TIME_ZONE=Europe/Kyiv
LANGUAGE_CODE=uk

# ─── Користувачі та квоти ───────────────────────────────────
# Відкрита реєстрація (false = лише за запрошеннями від адміністратора)
REGISTRATION_OPEN=false
# Квота за замовчуванням для нового користувача, ГБ
DEFAULT_QUOTA_GB=10
# Максимальний розмір одного файлу, ГБ
MAX_FILE_SIZE_GB=10
# Адміністратори зобов'язані мати 2FA
REQUIRE_2FA_FOR_STAFF=true

# ─── Файли ──────────────────────────────────────────────────
S3_BUCKET=blackcloud-files
# Що робити з файлами, які ClamAV не може перевірити (завеликі): block | allow
UNSCANNED_POLICY=block

# ─── Пошта ──────────────────────────────────────────────────
# Поштовий домен (MX-запис має вказувати на MAIL_HOSTNAME)
MAIL_DOMAIN=example.com
MAIL_HOSTNAME=mail.example.com
# Автоматично створювати скриньку username@MAIL_DOMAIN для нових користувачів
MAIL_AUTO_CREATE=true
MAIL_DEFAULT_QUOTA_MB=2048
